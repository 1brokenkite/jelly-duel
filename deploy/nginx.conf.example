# 在 Nginx 的 http 块中 include 此文件；替换域名及证书绝对路径。
map $http_upgrade $jelly_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name game.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name game.example.com;
    ssl_certificate /etc/nginx/certs/game.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/game.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # 保留浏览器访问的 Host，便于 Socket.io 同源校验。
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jelly_connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
